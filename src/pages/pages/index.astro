---
import { fixedPages } from "../../utils/fixed-pages";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

const pages = [...fixedPages].sort((a, b) =>
    a.title.localeCompare(b.title, "zh-CN"),
);
---
<MainGridLayout title="固定页面" description="Season Blog 的固定页面">
    <div class="card-base px-9 py-6">
        <Markdown class="mt-2">
            <h1>固定页面</h1>
            {pages.length > 0 ? (
                <ul>
                    {pages.map((page) => (
                        <li><a href={`/pages/${page.slug}/`}>{page.title}</a></li>
                    ))}
                </ul>
            ) : <p>暂无固定页面。</p>}
        </Markdown>
    </div>
</MainGridLayout>
