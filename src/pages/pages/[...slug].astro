---

import { fixedPages } from "../../utils/fixed-pages";
import Markdown from "@components/misc/Markdown.astro";
import ReadingList from "@components/ReadingList.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";

export function getStaticPaths() {
    return fixedPages.map((page) => ({
        params: { slug: page.slug },
        props: { page },
    }));
}

const { page } = Astro.props;
const { Content, title } = page;
---
<MainGridLayout title={title} description={title}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <h1>{title}</h1>
                {page.slug === "看书清单" ? <ReadingList><Content /></ReadingList> : <Content />}
            </Markdown>
        </div>
    </div>
</MainGridLayout>
